{
  "name": "wow-training-dummy-log-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:negative": "node scripts/check-negative-lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "captures:stats": "node scripts/capture-stats.mjs",
    "verify": "npm run format:check && npm run lint && npm run lint:negative && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,json,md,mjs,ts,tsx,yml,yaml}": "prettier --check",
    "*.{mjs,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
