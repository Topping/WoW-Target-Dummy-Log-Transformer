{
  "name": "wow-training-dummy-log-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "audit:production": "node scripts/audit-production.mjs",
    "audit:pages": "node scripts/audit-pages-artifact.mjs",
    "demo:record": "npm run build && node scripts/record-product-demo.mjs",
    "preview": "vite preview",
    "preview:pages": "node scripts/serve-pages-artifact.mjs",
    "test": "vitest run --exclude 'tests/*-captures.test.ts' --exclude 'tests/*capture-wide.test.ts' --exclude 'tests/worker-capture.test.ts' --exclude 'tests/performance/**'",
    "test:capture-wide": "vitest run tests/capture-inventory-capture-wide.test.ts tests/parser-captures.test.ts tests/discovery-captures.test.ts tests/extraction-captures.test.ts tests/worker-capture.test.ts",
    "test:performance": "vitest run tests/performance/capture-profile.test.ts --maxWorkers=1",
    "test:performance:profile": "D10_PROFILE=1 vitest run tests/performance/capture-profile.test.ts --maxWorkers=1 --reporter=verbose",
    "test:browser": "npm run build && playwright test",
    "test:browser:proxies": "npm run build && playwright test --project=chromium-proxy --project=firefox-proxy --project=webkit-proxy",
    "test:browser:chrome": "npm run build && playwright test --project=installed-chrome",
    "test:browser:pages:proxies": "PAGES_BASE_PATH=/WoW-Target-Dummy-Log-Transformer/ playwright test --project=chromium-proxy --project=firefox-proxy --project=webkit-proxy",
    "test:browser:pages:chrome": "PAGES_BASE_PATH=/WoW-Target-Dummy-Log-Transformer/ playwright test --project=installed-chrome",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:negative": "node scripts/check-negative-lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "captures:stats": "node scripts/capture-stats.mjs",
    "talents:update": "node scripts/generate-talent-data.mjs",
    "talents:check": "node scripts/generate-talent-data.mjs --check",
    "verify": "npm run format:check && npm run lint && npm run lint:negative && npm run typecheck && npm run test && npm run test:capture-wide && npm run test:performance",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,json,md,mjs,ts,tsx,yml,yaml}": "prettier --check",
    "*.{mjs,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
